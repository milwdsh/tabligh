*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:"Vazirmatn",sans-serif;
}

body{
background:#0f172a;
color:#fff;
line-height:1.8;
}

a{
text-decoration:none;
color:#fff;
}

header{
width:100%;
padding:20px 8%;
display:flex;
justify-content:space-between;
align-items:center;
background:#111827;
position:sticky;
top:0;
z-index:1000;
box-shadow:0 5px 20px rgba(0,0,0,.3);
}

.logo{
font-size:30px;
font-weight:800;
color:#fbbf24;
}

nav{
display:flex;
gap:30px;
}

nav a{
transition:.3s;
font-weight:500;
}

nav a:hover{
color:#fbbf24;
}

.buttons{
display:flex;
gap:10px;
}

button{
border:none;
cursor:pointer;
padding:12px 24px;
border-radius:10px;
font-size:15px;
transition:.3s;
}

.login{
background:transparent;
border:2px solid #fbbf24;
color:#fbbf24;
}

.login:hover{
background:#fbbf24;
color:#111827;
}

.register{
background:#fbbf24;
color:#111827;
font-weight:700;
}

.register:hover{
transform:translateY(-2px);
}

.hero{
padding:100px 8%;
text-align:center;
}

.hero h1{
font-size:52px;
margin-bottom:20px;
}

.hero p{
font-size:20px;
color:#cbd5e1;
max-width:700px;
margin:auto;
}

.heroButtons{
margin-top:40px;
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.primary{
background:#fbbf24;
color:#111827;
font-weight:700;
}

.primary:hover{
transform:scale(1.05);
}

.secondary{
background:#1e293b;
color:#fff;
border:1px solid #334155;
}

.secondary:hover{
background:#334155;
}

.categories{
padding:80px 8%;
}

.categories h2{
text-align:center;
font-size:34px;
margin-bottom:40px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
gap:20px;
}

.card{
background:#1e293b;
padding:30px;
border-radius:16px;
text-align:center;
font-size:20px;
transition:.3s;
cursor:pointer;
}

.card:hover{
background:#fbbf24;
color:#111827;
transform:translateY(-8px);
}

.stats{
padding:80px 8%;
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
}

.box{
background:#111827;
padding:40px;
border-radius:16px;
text-align:center;
}

.box h3{
font-size:42px;
color:#fbbf24;
margin-bottom:10px;
}

.box p{
color:#cbd5e1;
}

footer{
margin-top:60px;
padding:30px;
text-align:center;
background:#111827;
color:#94a3b8;
}

@media(max-width:900px){

header{
flex-direction:column;
gap:20px;
}

nav{
flex-wrap:wrap;
justify-content:center;
}

.hero h1{
font-size:36px;
}

.hero p{
font-size:17px;
}

}
.loginBox select{

width:100%;

padding:16px;

margin-bottom:18px;

border:none;

outline:none;

border-radius:12px;

background:#1e293b;

color:white;

font-size:15px;

}

/* ===========================
   THEME
=========================== */

:root{

--primary:#fbbf24;
--primaryHover:#f59e0b;

--dark:#0f172a;
--dark2:#111827;
--dark3:#1e293b;

--white:#ffffff;

--text:#cbd5e1;

--success:#22c55e;
--danger:#ef4444;
--warning:#f59e0b;

--radius:18px;

}

/* ===========================
   SCROLLBAR
=========================== */

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#0f172a;

}

::-webkit-scrollbar-thumb{

background:#fbbf24;

border-radius:20px;

}

/* ===========================
   ANIMATION
=========================== */

@keyframes fade{

from{

opacity:0;

transform:translateY(20px);

}

to{

opacity:1;

transform:translateY(0);

}

}

/* ===========================
   CARD
=========================== */

.cardBox{

background:#111827;

border-radius:18px;

padding:25px;

box-shadow:0 10px 30px rgba(0,0,0,.25);

animation:fade .5s;

}

/* ===========================
   BUTTON
=========================== */

.btn{

background:#fbbf24;

color:#111827;

padding:14px 26px;

border:none;

border-radius:12px;

cursor:pointer;

font-weight:bold;

transition:.3s;

}

.btn:hover{

transform:translateY(-3px);

background:#f59e0b;

}

/* ===========================
   INPUT
=========================== */

.input{

width:100%;

padding:15px;

background:#1e293b;

border:none;

border-radius:12px;

color:white;

outline:none;

}

/* ===========================
   GLASS
=========================== */

.glass{

background:rgba(255,255,255,.05);

backdrop-filter:blur(15px);

border:1px solid rgba(255,255,255,.08);

border-radius:20px;

}

/* ===========================
   SHADOW
=========================== */

.shadow{

box-shadow:0 15px 35px rgba(0,0,0,.25);

}

.dashboard{

display:flex;

min-height:100vh;

}

.sidebar{

width:270px;

background:#111827;

padding:30px;

display:flex;

flex-direction:column;

}

.sidebar ul{

list-style:none;

margin-top:40px;

}

.sidebar li{

display:flex;

align-items:center;

gap:15px;

padding:15px;

margin-bottom:12px;

border-radius:12px;

cursor:pointer;

transition:.3s;

}

.sidebar li:hover{

background:#1e293b;

}

.sidebar li.active{

background:#fbbf24;

color:#111827;

font-weight:bold;

}

.content{

flex:1;

padding:35px;

background:#0f172a;

}

.topBar{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:35px;

}

.userBox{

display:flex;

align-items:center;

gap:10px;

font-size:18px;

}

.userBox i{

font-size:34px;

color:#fbbf24;

}

.cards{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:20px;

margin-bottom:35px;

}

.orders{

background:#111827;

border-radius:18px;

padding:25px;

min-height:300px;

}

@media(max-width:900px){

.dashboard{

flex-direction:column;

}

.sidebar{

width:100%;

}

.cards{

grid-template-columns:1fr;

}

}

.cardBox{

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

gap:15px;

background:#111827;

border-radius:18px;

padding:30px;

transition:.3s;

}

.cardBox:hover{

transform:translateY(-6px);

}

.cardBox i{

font-size:40px;

color:#fbbf24;

}

.cardBox h2{

font-size:36px;

}

.cardBox p{

color:#94a3b8;

}

.toast{

position:fixed;

top:25px;

left:50%;

transform:translateX(-50%) translateY(-30px);

padding:15px 25px;

border-radius:12px;

color:#fff;

font-size:15px;

font-weight:bold;

opacity:0;

transition:.3s;

z-index:99999;

box-shadow:0 10px 30px rgba(0,0,0,.3);

}

.toast.show{

opacity:1;

transform:translateX(-50%) translateY(0);

}

.toast.success{

background:#16a34a;

}

.toast.error{

background:#dc2626;

}

.toast.warning{

background:#d97706;

}

.toast.info{

background:#2563eb;

}

.cardBox.admin{
    background:#eaf3ff;
    border-right:5px solid #0d6efd;
}

.cardBox.customer{
    background:#eafaf1;
    border-right:5px solid #198754;
}

.cardBox.advertiser{
    background:#fff4e5;
    border-right:5px solid #fd7e14;
}

.cardBox.admin p:first-child{
    color:#0d6efd;
    font-weight:bold;
}

.cardBox.customer p:first-child{
    color:#198754;
    font-weight:bold;
}

.cardBox.advertiser p:first-child{
    color:#fd7e14;
    font-weight:bold;
}

/* ================= CHAT ================= */

.chatArea{

height:65vh;

overflow-y:auto;

display:flex;

flex-direction:column;

gap:12px;

padding:15px;

background:#f7f7f7;

border-radius:15px;

}



.chatInput{

display:flex;

gap:10px;

margin-top:15px;

}



.chatInput textarea{

flex:1;

resize:none;

height:70px;

border:1px solid #ddd;

border-radius:12px;

padding:10px;

font-family:Vazirmatn;

font-size:15px;

}



.message{

max-width:75%;

padding:12px;

border-radius:18px;

box-shadow:0 3px 10px rgba(0,0,0,.08);

animation:fade .2s;

}



.message.mine{

align-self:flex-end;

}



.message.other{

align-self:flex-start;

}



.message .sender{

font-weight:bold;

margin-bottom:8px;

font-size:14px;

}



.message .time{

font-size:12px;

opacity:.7;

margin-top:8px;

display:block;

}



/* مشتری */

.customer{

background:#e8f8ed;

border-right:5px solid #28a745;

}



/* صاحب پیج */

.advertiser{

background:#fff4df;

border-right:5px solid #ff9800;

}



/* ادمین */

.admin{

background:#e8f0ff;

border-right:5px solid #0d6efd;

}



@keyframes fade{

from{

opacity:0;

transform:translateY(10px);

}

to{

opacity:1;

transform:translateY(0);

}

}

/* متن داخل پیام چت */

.message{

    color:#222 !important;

}



.message .sender{

    color:#222 !important;

}



.message .message-text{

    color:#222 !important;

}



.message small{

    color:#555 !important;

}



.message .time{

    color:#666 !important;

}



/* رنگ عنوان نقش ها */

.message.admin .sender{

    color:#0d6efd !important;

}



.message.customer .sender{

    color:#198754 !important;

}



.message.advertiser .sender{

    color:#fd7e14 !important;

}

.dashboard-info{

    margin-top:20px;

}



.guideBox{

    line-height:2;

    background:#fff;

}



.ticketNotice{

    background:#eef7ff;

    border-right:5px solid #0d6efd;

}



.guideBox h3,
.ticketNotice h3{

    margin-bottom:15px;

}

/* رنگ متن داشبورد */

.dashboard-info,
.dashboard-info p,
.dashboard-info h3,
.ticketNotice,
.ticketNotice p,
.ticketNotice h3,
.guideBox,
.guideBox p,
.guideBox h3{

    color:#222 !important;

}



.ticketNotice .btn{

    color:white !important;

}

/* کارت های آماری داشبورد */

.cards{

display:flex;
gap:15px;
flex-wrap:wrap;

}



.statCard{

background:#fff;

padding:15px;

border-radius:12px;

text-align:center;

flex:1;

min-width:150px;

box-shadow:0 3px 10px rgba(0,0,0,.08);

}



.statCard i{

font-size:25px;

margin-bottom:8px;

color:#0d6efd;

}



.statCard h2{

font-size:24px;

margin:5px 0;

}



.statCard p{

margin:0;

font-size:14px;

color:#555;

}

/* کوچک کردن فقط کارت های آماری بالا */

.cards .cardBox{

    padding:10px !important;

    min-height:90px !important;

}



.cards .cardBox i{

    font-size:22px !important;

}



.cards .cardBox h2{

    font-size:22px !important;

    margin:5px 0 !important;

}



.cards .cardBox p{

    font-size:13px !important;

    margin:0 !important;

}

/* اصلاح فقط کارت کل سفارش ها */

.cards .cardBox:first-child{

    padding:10px !important;

    height:auto !important;

    min-height:90px !important;

}



.cards .cardBox:first-child i{

    font-size:22px !important;

}



.cards .cardBox:first-child h2{

    font-size:22px !important;

    margin:5px 0 !important;

}



.cards .cardBox:first-child p{

    margin:0 !important;

    font-size:14px !important;

}


/* کارت های آماری داشبورد */

.cards .dashboardStat{

    padding:15px !important;

    min-height:100px !important;

    background:inherit !important;

    color:inherit !important;

}



.cards .dashboardStat i{

    font-size:24px;

}



.cards .dashboardStat h2{

    font-size:24px;

    margin:5px 0;

}



.cards .dashboardStat p{

    font-size:14px;

    margin:0;

}

/* چیدمان کارت های داشبورد */

.cards{

    display:flex;

    gap:15px;

    align-items:stretch;

    flex-wrap:nowrap;

}



.cards .cardBox{

    flex:1;

    min-width:0;

    text-align:center;

}

@media(max-width:700px){

.cards{

    flex-wrap:wrap;

}


.cards .cardBox{

    width:100%;

}

}

.message{

    margin-bottom:10px;

    padding:12px;

    border-radius:12px;

    line-height:2;

}


.message .time{

    display:block;

    margin-top:8px;

    font-size:12px;

    opacity:.7;

}


.messageText{

    margin-top:8px;

    word-break:break-word;

}



.messages{

    max-height:500px;

    overflow-y:auto;

    padding:10px;

}


/* =======================
   SIDEBAR MODERN
======================= */

.sidebar{
    width:270px;
    background:linear-gradient(180deg,#111827,#0f172a);
    border-left:1px solid rgba(255,255,255,.05);
    box-shadow:0 0 25px rgba(0,0,0,.25);
    padding:25px 18px;
}

.sidebar h2{
    color:#fbbf24;
    text-align:center;
    font-size:28px;
    margin-bottom:30px;
    font-weight:800;
    letter-spacing:.5px;
}

.sidebar a{
    display:flex;
    align-items:center;
    gap:14px;
    padding:14px 18px;
    margin-bottom:10px;
    border-radius:14px;
    color:#d1d5db;
    font-size:15px;
    font-weight:500;
    transition:.25s;
}

.sidebar a i{
    width:22px;
    text-align:center;
    color:#fbbf24;
    font-size:17px;
}

.sidebar a:hover{
    background:#1f2937;
    color:#fff;
    transform:translateX(-4px);
}

.sidebar a.active{
    background:#fbbf24;
    color:#111827;
    font-weight:700;
}

.sidebar a.active i{
    color:#111827;
}


/* ===========================
   MOBILE SIDEBAR
=========================== */

.topHeader{
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:#111827;
    padding:15px 20px;
    border-radius:14px;
    margin-bottom:20px;
}

.menuBtn{
    width:44px;
    height:44px;
    border:none;
    border-radius:10px;
    background:#fbbf24;
    color:#111827;
    font-size:20px;
    cursor:pointer;
}

.userInfo{
    display:flex;
    align-items:center;
    gap:8px;
}

.userInfo i{
    color:#fbbf24;
    font-size:24px;
}

/* حالت موبایل */

@media (max-width:900px){

    .sidebar{

        position:fixed;

        top:0;
        right:-280px;

        width:260px;
        height:100vh;

        z-index:9999;

        transition:.35s;

        overflow-y:auto;

    }

    body.sidebarOpen .sidebar{

        right:0;

    }

    .content{

        width:100%;
        margin:0;

    }

}

.sidebarOpen::before{

    content:"";

    position:fixed;

    inset:0;

    background:rgba(0,0,0,.5);

    z-index:9998;

}


.sidebar{

    z-index:9999;

}


.closeMenuBtn{

    display:none;

    background:none;

    color:white;

    font-size:28px;

    padding:5px;

    align-self:flex-start;

}


@media(max-width:850px){

.sidebar{

    position:fixed;

    top:0;

    right:-300px;

    height:100vh;

    width:270px;

    transition:.3s;

}


.sidebarOpen .sidebar{

    right:0;

}


.closeMenuBtn{

    display:block;

}

}
