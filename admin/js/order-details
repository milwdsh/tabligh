function orderStatusFa(status){


switch(status){


case "pending_payment":

return "⏳ در انتظار پرداخت";


case "pending":

return "⌛ در انتظار تایید";


case "accepted":

return "✅ تایید شده";


case "rejected":

return "❌ رد شده";


case "completed":

return "🎉 انجام شده";


default:

return status || "-";


}

}







function paymentStatusFa(status){


switch(status){


case "unpaid":

return "❌ پرداخت نشده";


case "paid":

return "✅ پرداخت شده";


case "pending":

return "⏳ در انتظار پرداخت";


default:

return status || "-";


}

}